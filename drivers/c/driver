CYBPARSER="${CYBPARSER:-$HOME/sources/libcyberiadaml/build/parser/cybparser}"

case "$1" in
info)
    [ -x "$CYBPARSER" ] || {
        echo "cybparser not found: $CYBPARSER" >&2
        exit 1
    }
    VERSION=$(git -C "$(dirname "$CYBPARSER")/../.." \
        describe --tags --always 2>/dev/null || echo unknown)
    printf '{"name": "libcyberiadaml", "version": "%s", "profiles": ["CORE", "EXT-COMPLETENESS", "EXT-DISPLAY", "EXT-PLATFORM"]}\n' \
        "$VERSION"
    ;;
convert)
    [ -n "$2" ] && [ -n "$3" ] || {
        echo "usage: driver convert IN.graphml OUT.graphml" >&2
        exit 64
    }
    # cybparser reports its diagnostics on stdout
    OUTPUT=$("$CYBPARSER" convert -s -f cyberiada -t cyberiada -g "$2" -o "$3" 2>&1)
    RC=$?
    [ "$RC" -eq 0 ] && exit 0
    # signal deaths (126+) are crashes; other failures are rejections
    [ "$RC" -ge 126 ] && { echo "$OUTPUT" >&2; exit 1; }
    FIRST=$(printf '%s\n' "$OUTPUT" | sed -n '1p')
    echo "rejected by libcyberiadaml: ${FIRST:-cybparser exit $RC}" >&2
    exit 2
    ;;
*)
    echo "usage: driver info | driver convert IN.graphml OUT.graphml" >&2
    exit 64
    ;;
esac

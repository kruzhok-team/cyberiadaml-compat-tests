DIR=$(dirname "$0")
LIB="${CYBERIADAML_CS:-$HOME/sources/cyberiada-logic-unity-pkg}"
DOTNET="${DOTNET:-$HOME/.dotnet/dotnet}"
BIN="$DIR/bin/Release/net8.0/CgmlDriver.dll"

case "$1" in
info)
    [ -x "$DOTNET" ] && [ -f "$BIN" ] || {
        echo "driver not built: run \"$DOTNET\" build -c Release \"$DIR\"" >&2
        exit 1
    }
    VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' \
        "$LIB/package.json" 2>/dev/null | head -1)
    printf '{"name": "cyberiada-logic-unity-pkg", "version": "%s", "profiles": ["CORE"]}\n' \
        "${VERSION:-unknown}"
    ;;
convert)
    [ -n "$2" ] && [ -n "$3" ] || {
        echo "usage: driver convert IN.graphml OUT.graphml" >&2
        exit 64
    }
    exec "$DOTNET" "$BIN" "$2" "$3"
    ;;
*)
    echo "usage: driver info | driver convert IN.graphml OUT.graphml" >&2
    exit 64
    ;;
esac

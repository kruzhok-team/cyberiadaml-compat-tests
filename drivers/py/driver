import json
import pathlib
import sys

LIB = pathlib.Path(
    __import__("os").environ.get("CYBERIADAML_PY",
                                 pathlib.Path.home() / "sources/cyberiadaml-py"))


def info():
    try:
        sys.path.insert(0, str(LIB))
        import cyberiadaml_py  # noqa: F401
    except Exception as err:
        print("cyberiadaml-py unavailable: %s" % err, file=sys.stderr)
        return 1
    version = "unknown"
    try:
        import tomllib
        pyproject = tomllib.loads((LIB / "pyproject.toml").read_text())
        version = pyproject["tool"]["poetry"]["version"]
    except Exception:
        pass
    print(json.dumps({"name": "cyberiadaml-py", "version": version,
                      "profiles": ["CORE"]}))
    return 0


def convert(src, dst):
    sys.path.insert(0, str(LIB))
    from cyberiadaml_py.cyberiadaml_builder import (CGMLBuilder,
                                                    CGMLBuilderException)
    from cyberiadaml_py.cyberiadaml_parser import (CGMLParser,
                                                   CGMLParserException)
    text = pathlib.Path(src).read_text(encoding="utf-8")
    try:
        elements = CGMLParser().parse_cgml(text)
        output = CGMLBuilder().build(elements)
    except (CGMLParserException, CGMLBuilderException) as err:
        print("rejected by cyberiadaml-py: %s" % err, file=sys.stderr)
        return 2
    pathlib.Path(dst).write_text(output, encoding="utf-8")
    return 0


def main(argv):
    if len(argv) >= 2 and argv[1] == "info":
        return info()
    if len(argv) >= 4 and argv[1] == "convert":
        return convert(argv[2], argv[3])
    print("usage: driver info | driver convert IN.graphml OUT.graphml",
          file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv))
